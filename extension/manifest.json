{
  "manifest_version": 3,
  "name": "PennReach",
  "version": "0.1.0",
  "description": "Find incoming Penn seniors at top firms on LinkedIn, get their Penn email, and send coffee-chat requests from Gmail.",
  "key": "",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://directory.apps.upenn.edu/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open PennReach",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "lib/core.js",
        "lib/store.js",
        "content/linkedin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://directory.apps.upenn.edu/directory/*"
      ],
      "js": [
        "lib/core.js",
        "lib/store.js",
        "content/directory.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
